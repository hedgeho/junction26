# Copy to the repo root as .env. Grouped by the package that reads each variable.

# --- core (all processes)
# Public hostname; the feed generator's DID is did:web:$HOSTNAME.
# Anything ending in .localhost / starting with 127.0.0.1 switches OAuth to loopback dev mode.
HOSTNAME=127.0.0.1
# DID of the account that publishes the feed record (scripts/publish_feed.py prints it).
PUBLISHER_DID=
FEED_RKEY=curated

# --- ingest
KEEP_LANGS=["en"]
RETENTION_HOURS=48

# --- curation (also used by web for feedback interpretation)
ANTHROPIC_API_KEY=
SCORER_MODEL=claude-opus-5-5
PROFILE_MODEL=claude-opus-5-5
SCORER_EFFORT=low
CURATE_INTERVAL_S=600
CANDIDATES_PER_CYCLE=400

# --- web
SESSION_SECRET=   # openssl rand -hex 32

# --- scripts/publish_feed.py only
BSKY_PDS=https://bsky.social
BSKY_HANDLE=
BSKY_APP_PASSWORD=
