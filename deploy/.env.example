# All runtime state remains on one application host.
HOSTNAME=127.0.0.1
PUBLISHER_DID=
FEED_RKEY=curated
DATA_DIR=data

# Ingest
KEEP_LANGS=["en"]
RETENTION_HOURS=48

# Select gemma to keep note-derived feed interests on Modal. Existing installations can retain decisions or generative.
SCORING_BACKEND=gemma
# Optional Gemini credentials for Gemini scoring modes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SCORE_BATCH_SIZE=20
CANDIDATES_PER_CYCLE=400
CANDIDATE_POOL_SIZE=4000
DAILY_SCORING_CAP=5000
CURATE_INTERVAL_S=60
READER_CONCURRENCY=4

# Private Gemma on Modal: endpoint base includes /v1.
GEMMA_URL=
GEMMA_TOKEN=
GEMMA_MODEL=google/gemma-3-12b-it
INFERENCE_TIMEOUT_S=120

# Web cookie signing; set a strong random value in production.
SESSION_SECRET=

# One-time Bluesky feed registration only. No social post publishing is implemented.
BSKY_PDS=https://bsky.social
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Optional read-only Markdown notes. Local paths must fall under these roots.
# Default when empty: ./notes. Separate multiple roots with : on Linux or ; on Windows.
AGORA_NOTES_ROOTS=
# Optional private Google Drive notes; share the folder with this service account as Viewer.
# Keep the JSON key outside Git, readable only by the application service user.
GOOGLE_APPLICATION_CREDENTIALS=
LABEL_CHECKS=true
MAX_AUTHOR_POSTS_PER_DAY=150
CAMPAIGN_MIN_AUTHORS=5
TRIAGE_ENABLED=true
TRIAGE_CONCURRENCY=8
DECISION_MINIMUM_RELEVANCE=0.4
DECISION_CONCURRENCY=8
# Keep under the Gemini project's input-token limit; the free tier allows 50000.
DECISION_TOKENS_PER_MINUTE=500000
SOCIAL_SLOTS=3
SERENDIPITY_SHARE=0.1
BACKGROUND_SCORE_INTERVAL_S=600

# Optional Threads keyword search with one operator token (threads_basic + threads_keyword_search + threads_read_replies).
# Only the token owner's posts are searchable until Meta approves threads_keyword_search.
THREADS_ACCESS_TOKEN=
THREADS_POLL_INTERVAL_S=1800
THREADS_TERMS_PER_CYCLE=40
BACKGROUND_SCORE_INTERVAL_S=300
